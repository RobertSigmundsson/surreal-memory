# SurrealMemory Environment Variables
# Copy this file to .env and fill in values as needed.

# --- Core ---
# Data directory (default: ~/.surrealmemory)
# SURREAL_MEMORY_DIR=/path/to/data

# Default brain name
# SURREAL_MEMORY_BRAIN=default

# --- Server ---
# Host and port for the API server
# SURREAL_MEMORY_HOST=127.0.0.1
# SURREAL_MEMORY_PORT=8000

# Trusted networks (CIDR notation, comma-separated)
# SURREAL_MEMORY_TRUSTED_NETWORKS=172.17.0.0/16

# --- SurrealDB (graph + vector storage backend) ---
# SURREALDB_URL=http://localhost:8001
# SURREALDB_USER=root
# SURREALDB_PASS=surrealmemory
# SURREALDB_NS=surreal_memory
# SURREALDB_DB=default

# --- Storage Backend ---
# Production: surrealdb (default; see docker-compose.surrealdb.yml).
# `sqlite` is retained only as an internal test fixture — not supported
# for production.
SURREAL_MEMORY_STORAGE=surrealdb

# --- Encryption ---
# Enable memory encryption at rest
# SURREAL_MEMORY_ENCRYPTION_ENABLED=false
# SURREAL_MEMORY_ENCRYPTION_KEYS_DIR=/path/to/keys

# --- Sync (Hub) ---
# Hub server URL for multi-device sync
# SURREAL_MEMORY_HUB_URL=https://your-sync-hub.example.workers.dev
# SURREAL_MEMORY_API_KEY=nmk_your_key_here
# SURREAL_MEMORY_DEVICE_ID=my-laptop
# SURREAL_MEMORY_SYNC_ENABLED=true
# SURREAL_MEMORY_SYNC_AUTO=true



# --- Embedding (Gemini 2.0) ---
# SURREAL_MEMORY_EMBEDDING_ENABLED=true
# SURREAL_MEMORY_EMBEDDING_PROVIDER=gemini
# SURREAL_MEMORY_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_API_KEY=your-gemini-api-key

# --- Embedding (other providers) ---
# OPENAI_API_KEY=

# --- Claude Code hooks ---
# Session ID (auto-set by Claude Code)
# CLAUDE_SESSION_ID=
