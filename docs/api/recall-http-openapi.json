  "components": {
    "schemas": {
      "BladOut": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          },
          "powod": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Powod"
          },
          "detail": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/BladSzczegol"
