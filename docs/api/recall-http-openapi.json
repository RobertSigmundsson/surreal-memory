          "priority",
          "neurons_created",
          "neurons_linked",
          "synapses_created",
          "anchor_neuron_id",
          "content_sha256",
          "oczyszczone",
          "agent_id",
          "tor",
          "elapsed_ms"
        ],
        "title": "RememberOut",
        "description": "``smem remember --json`` of the host CLI plus shim fields."
