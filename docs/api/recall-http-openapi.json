{
  "openapi": "3.1.0",
  "info": {
    "title": "smem recall-http",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/recall": {
      "post": {
        "summary": "Recall",
        "operationId": "recall_v1_recall_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecallIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecallOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MemoryOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "neuron_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Neuron Id"
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "rank": {
            "type": "integer",
            "title": "Rank"
          }
        },
        "type": "object",
        "required": [
          "id",
          "neuron_id",
          "type",
          "content",
          "score",
          "rank"
        ],
        "title": "MemoryOut"
      },
      "RecallIn": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query"
          },
          "limit": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 5
          },
          "depth": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Depth",
            "default": 1
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 500
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:@|-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "agent_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:@-]+$",
            "title": "Agent Id"
          },
          "tor": {
            "type": "string",
            "pattern": "^http:[a-z0-9][a-z0-9-]{0,31}$",
            "title": "Tor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "agent_id",
          "tor"
        ],
        "title": "RecallIn",
        "description": "Request body of ``POST /v1/recall``."
      },
      "RecallOut": {
        "properties": {
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "sufficient": {
            "type": "boolean",
            "title": "Sufficient"
          },
          "memories": {
            "items": {
              "$ref": "#/components/schemas/MemoryOut"
            },
            "type": "array",
            "title": "Memories"
          },
          "neurons_activated": {
            "type": "integer",
            "title": "Neurons Activated"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          },
          "trace_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Error"
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms"
          },
          "engine_latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine Latency Ms"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "tor": {
            "type": "string",
            "title": "Tor"
          },
          "score_kind": {
            "type": "string",
            "const": "anchor_activation",
            "title": "Score Kind"
          },
          "rerank_degraded": {
            "type": "boolean",
            "title": "Rerank Degraded"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "confidence",
          "sufficient",
          "memories",
          "neurons_activated",
          "trace_id",
          "trace_error",
          "elapsed_ms",
          "engine_latency_ms",
          "path",
          "tor",
          "score_kind",
          "rerank_degraded"
        ],
        "title": "RecallOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
