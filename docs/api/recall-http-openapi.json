        },
        "type": "object",
        "required": [
          "loc",
          "msg"
        ],
        "title": "BladSzczegol"
      },
      "CliRecallIn": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query"
          },
          "depth": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 3.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Depth"
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 500
          },
          "min_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Min Confidence",
            "default": 0.0
          },
          "agent_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:@-]+$",
            "title": "Agent Id"
          },
          "tor": {
            "type": "string",
            "pattern": "^http:[a-z0-9][a-z0-9-]{0,31}$",
            "title": "Tor"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:@|-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "agent_id",
          "tor"
