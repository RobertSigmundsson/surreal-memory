          "tags": {
            "items": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Tags"
          },
          "priority": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Priority"
          },
          "agent_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:@-]+$",
