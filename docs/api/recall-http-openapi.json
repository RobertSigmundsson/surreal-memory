                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "typy": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
