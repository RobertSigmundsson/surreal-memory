          },
          "tor": {
            "type": "string",
            "pattern": "^http:[a-z0-9][a-z0-9-]{0,31}$",
            "title": "Tor"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._:@|-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          }
        },
